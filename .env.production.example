# Copy this file to .env.production on the VPS and replace every placeholder.
# API hostname on this VPS; point its DNS A record to the VPS public IP.
DOMAIN=api.school.example.com
# Public HTTPS origin(s) of the Hostinger frontend, comma separated.
CORS_ORIGINS=https://school.example.com
PUBLIC_APP_URL=https://school.example.com
POSTGRES_DB=school_substitution
POSTGRES_USER=school_admin
# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_a_unique_64_character_hex_secret
SESSION_SECRET=replace_with_a_unique_64_character_hex_secret
LICENSE_HASH_SECRET=replace_with_a_different_64_character_hex_secret
SCHOOL_TIMEZONE=Asia/Amman
# Closed by default. The first administrator is created using the CLI command in DEPLOYMENT.md.
REGISTRATION_ENABLED=false
# SMTP is required for staff invitations and for public registration/license emails.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=mailer@example.com
EMAIL_PASSWORD=replace_with_smtp_password
EMAIL_FROM=mailer@example.com
EMAIL_USE_SSL=false
EMAIL_USE_STARTTLS=true
DISCORD_WEBHOOK_URL=
# Ollama runs as a private container on the same VPS; it is not exposed publicly.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=180
